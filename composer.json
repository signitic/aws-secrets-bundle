{
    "name": "signitic/aws-secrets-bundle",
    "type": "symfony-bundle",
    "description": "Use AWS Secrets as service container parameters in Symfony.",
    "keywords": ["Symfony", "AWS", "ENV", "Secrets Manager"],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "symfony/dependency-injection": "^8.0",
        "ext-json": "*"
    },
    "require-dev": {
        "symfony/framework-bundle": "^8.0",
        "phpunit/phpunit": "^12.0",
        "symfony/phpunit-bridge": "^8.0",
        "phpspec/prophecy-phpunit": "^2.0",
        "aws/aws-sdk-php": "^3.305"
    },
    "autoload": {
        "psr-4": {
            "Constup\\AwsSecretsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Constup\\AwsSecretsBundle\\Tests\\": "tests/"
        }
    }
}
